# Public values only. Do not commit real values, and do not paste them into chat.
#
# VITE_SUPABASE_URL is the practice project address ending in .supabase.co.
# If the copied address ends in /rest/v1/, the app ignores that ending.
# VITE_SUPABASE_PUBLISHABLE_KEY is the publishable key.
# Do not put the secret key or the service-role key in either name.
#
# For the later Cloudflare Pages practice site, set these same two names
# as production build variables. See docs/phase-3-pages.md.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
