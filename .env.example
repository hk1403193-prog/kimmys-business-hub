# Public values only. Copy this file to .env.local and fill it in there.
# .env.local stays on this computer. Do not commit it, and do not paste it into chat.
#
# Supabase dashboard → kimmys-hub-practice → Project Settings → API Keys
# Use the project URL and the publishable key.
# Do not put the secret key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
